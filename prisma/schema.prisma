generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions = [pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp"), vector]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  name         String?
  image        String?
  createdAt    DateTime     @default(now())
  accounts     Account[]
  memberships  Membership[]
  sessions     Session[]
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  orgId  String
  role   Role         @default(OWNER)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                     String       @id @default(cuid())
  name                   String
  createdAt              DateTime     @default(now())
  plan                   Plan         @default(FREE)
  planStatus             String?
  currentPeriodEnd       DateTime?
  messageQuota           Int          @default(100)
  messagesUsedThisPeriod Int          @default(0)
  razorpayCustomerId     String?      @unique
  razorpaySubscriptionId String?      @unique
  chatbots               Chatbot[]
  invites                Invite[]
  memberships            Membership[]
}

model Chatbot {
  id                 String         @id @default(cuid())
  orgId              String
  name               String
  systemPrompt       String         @default("You are a helpful assistant. Only answer using the provided context.")
  model              String         @default("claude-sonnet-4-6")
  temperature        Float          @default(0.3)
  widgetTitle        String         @default("Chat with us")
  widgetColor        String         @default("#6366f1")
  widgetLogoUrl      String?
  welcomeMessage     String         @default("Hi! Ask me anything about this site.")
  restrictToContext  Boolean        @default(true)
  leadCaptureEnabled Boolean        @default(false)
  status             ChatbotStatus  @default(READY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  allowedOrigins     String?
  widgetPosition     String         @default("bottom-right")
  widgetTheme        String         @default("classic")
  widgetSize         String         @default("medium")
  apiKeys            ApiKey[]
  org                Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  documents          Document[]

  @@index([orgId])
}

model Document {
  id           String          @id @default(cuid())
  chatbotId    String
  filename     String
  storageUrl   String
  fileType     String
  charCount    Int             @default(0)
  status       DocumentStatus  @default(PENDING)
  errorMessage String?
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  chatbot      Chatbot         @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([chatbotId])
}

model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  tokenCount Int
  embedding  Unsupported("vector")?
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ApiKey {
  id         String     @id @default(cuid())
  chatbotId  String
  name       String
  keyPrefix  String
  keyHash    String     @unique
  isActive   Boolean    @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())
  chatbot    Chatbot    @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  usageLogs  UsageLog[]

  @@index([chatbotId])
}

model UsageLog {
  id         String   @id @default(cuid())
  apiKeyId   String
  tokensIn   Int
  tokensOut  Int
  latencyMs  Int
  statusCode Int      @default(200)
  createdAt  DateTime @default(now())
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
}

model Conversation {
  id           String    @id @default(cuid())
  chatbotId    String
  sessionId    String
  visitorEmail String?
  createdAt    DateTime  @default(now())
  leadQuestion String?
  chatbot      Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([chatbotId, createdAt])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  role            String
  content         String
  wasAnswered     Boolean      @default(true)
  feedback        Int?
  createdAt       DateTime     @default(now())
  relatedQuestion String?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Invite {
  id         String       @id @default(cuid())
  orgId      String
  email      String
  role       Role         @default(MEMBER)
  token      String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  PRO
  SCALE
}

enum ChatbotStatus {
  DRAFT
  INGESTING
  READY
  ERROR
}

enum DocumentStatus {
  PENDING
  PARSING
  EMBEDDING
  READY
  FAILED
}
