generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // shadowDatabaseUrl is NOT used with Supabase — Supabase manages migrations
  // internally. Including it causes extra connection attempts that fail on
  // restricted networks (hostel LAN, mobile hotspots, etc).
  extensions = [pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp"), vector]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  name         String?
  image        String?
  createdAt    DateTime     @default(now())
  accounts     Account[]
  memberships  Membership[]
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  orgId  String
  role   Role         @default(OWNER)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())

  // Razorpay identity for the org-level subscription
  razorpayCustomerId     String?  @unique
  razorpaySubscriptionId String?  @unique
  plan                   Plan     @default(FREE)
  planStatus             String?               // "active" | "past_due" | "cancelled"
  currentPeriodEnd       DateTime?

  // Org-level aggregate quota (used by billing page + rate-limit checks)
  messageQuota           Int      @default(100)
  messagesUsedThisPeriod Int      @default(0)

  chatbots    Chatbot[]
  invites     Invite[]
  memberships Membership[]
  services    Service[]
}

model Service {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      ServiceType
  name      String
  status    String       @default("ACTIVE")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // FEATURE: per-service billing — each service is independently
  // subscribable, with its own plan and quota, not pooled with others.
  plan                   Plan      @default(FREE)
  razorpaySubscriptionId String?   @unique
  planStatus              String?
  currentPeriodEnd        DateTime?
  messageQuota             Int       @default(100)
  messagesUsedThisPeriod   Int       @default(0)

  apiKeys         ApiKey[]
  chatbot         Chatbot?
  toolAgent       ToolAgent?
  automationAgent AutomationAgent?

  @@index([orgId])
}


model Chatbot {
  id                 String         @id @default(cuid())
  orgId              String
  name               String
  systemPrompt       String         @default("You are a helpful assistant. Only answer using the provided context.")
  model              String         @default("claude-sonnet-4-6")
  temperature        Float          @default(0.3)
  widgetTitle        String         @default("Chat with us")
  widgetColor        String         @default("#6366f1")
  widgetLogoUrl      String?
  welcomeMessage     String         @default("Hi! Ask me anything about this site.")
  // FEATURE: Suggested starter questions shown as clickable chips under the
  // welcome message. Stored as newline-separated text for simple textarea
  // editing — parsed into an array at read time.
  suggestedQuestions String? @db.Text
  restrictToContext  Boolean        @default(true)
  leadCaptureEnabled Boolean        @default(false)
  status             ChatbotStatus  @default(READY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  allowedOrigins     String?
  widgetPosition     String         @default("bottom-right")
  widgetTheme        String         @default("classic")
  widgetSize         String         @default("medium")
  org                Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  documents          Document[]
  serviceId     String   @unique
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // FEATURE: memory type — "simple" | "short_term" | "long_term". Set only
  // at creation (not editable after), since it determines which URL
  // namespace and tab set the chatbot lives under.

  memoryType String @default("simple")

  userMemories UserMemory[] 

  @@index([orgId])
}

model Document {
  id           String          @id @default(cuid())
  chatbotId    String
  filename     String
  storageUrl   String
  fileType     String
  charCount    Int             @default(0)
  status       DocumentStatus  @default(PENDING)
  errorMessage String?
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  chatbot      Chatbot         @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([chatbotId])
}

model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  tokenCount Int
  embedding  Unsupported("vector(384)")?
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
model ApiKey {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name        String
  keyPrefix   String
  keyHash     String   @unique
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  usageLogs   UsageLog[]

  @@index([serviceId])
}

model UsageLog {
  id         String   @id @default(cuid())
  apiKeyId   String
  tokensIn   Int
  tokensOut  Int
  latencyMs  Int
  statusCode Int      @default(200)
  createdAt  DateTime @default(now())
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
}

model Conversation {
  id           String    @id @default(cuid())
  chatbotId    String
  sessionId    String
  visitorEmail String?
  createdAt    DateTime  @default(now())
  leadQuestion String?
  chatbot      Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([chatbotId, createdAt])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  role            String
  content         String
  wasAnswered     Boolean      @default(true)
  feedback        Int?
  createdAt       DateTime     @default(now())
  relatedQuestion String?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Invite {
  id         String       @id @default(cuid())
  orgId      String
  email      String
  role       Role         @default(MEMBER)
  token      String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  PRO
  SCALE
}

enum ChatbotStatus {
  DRAFT
  INGESTING
  READY
  ERROR
}

enum DocumentStatus {
  PENDING
  PARSING
  EMBEDDING
  READY
  FAILED
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


enum ServiceType {
  RAG
  AGENT
  CAG
  TOOL
  AUTOMATION
}



model ToolAgent {
  id           String   @id @default(cuid())
  serviceId    String   @unique
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name         String
  systemPrompt String   @default("You are a helpful assistant that can call tools to fetch real-time data for the user.")
  model        String   @default("openai/gpt-oss-120b")
  temperature  Float    @default(0.3)

  widgetTitle    String  @default("Chat with us")
  widgetColor    String  @default("#6366f1")
  welcomeMessage String  @default("Hi! I can look things up for you — ask away.")
  allowedOrigins String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools         ToolDefinition[]
  conversations AgentConversation[]
}

model ToolDefinition {
  id          String    @id @default(cuid())
  toolAgentId String
  toolAgent   ToolAgent @relation(fields: [toolAgentId], references: [id], onDelete: Cascade)

  name        String    // must match /^[a-zA-Z0-9_]+$/ — used as the function name the LLM calls
  description String    @db.Text  // tells the LLM WHEN to use this tool
  method      String    @default("GET") // GET | POST
  url         String    // the endpoint to call — validated against SSRF guard at call time, not just save time
  headers     Json?     // static headers, e.g. { "Authorization": "Bearer xyz" } — stored as-is, not encrypted (flagged below)
  paramsSchema Json     // JSON Schema describing the parameters the LLM should extract and send
  enabled     Boolean   @default(true)

  createdAt   DateTime  @default(now())

  @@index([toolAgentId])
}

model UserMemory {
  id                String   @id @default(cuid())
  chatbotId         String
  chatbot           Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  visitorIdentifier String   // stable per-visitor id (localStorage UUID, or email if captured)
  content           String   @db.Text   // extracted fact, e.g. "User prefers dark mode"
  importance        Float    @default(0.5)

  // FEATURE: 384 dims to match EMBEDDINGS_PROVIDER=local (Xenova). Same
  // caveat as DocumentChunk — switching to a paid 1536-dim provider later
  // requires re-embedding existing memories, not just new ones.
  embedding Unsupported("vector(384)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatbotId, visitorIdentifier])
}



model AutomationAgent {
  id        String   @id @default(cuid())
  serviceId String   @unique
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name String

  // FEATURE: the actual business logic customers configure — this IS the
  // product. No code, no workflow builder, just plain-language criteria
  // the AI uses to score and respond to every lead.
  qualificationCriteria String @db.Text @default("A qualified lead clearly states a business need, timeline, or budget.")
  redFlags               String? @db.Text
  followUpTone            String @default("Friendly, professional, concise. Reference what the person specifically asked about.")
  notifyEmail              String?  // business owner gets alerted on qualified leads

  // Widget branding — same pattern as Chatbot
  widgetTitle    String @default("Get in touch")
  widgetColor    String @default("#f2a93b")
  successMessage String @default("Thanks! We'll be in touch shortly.")
  allowedOrigins String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads LeadRecord[]
}

model LeadRecord {
  id                String          @id @default(cuid())
  automationAgentId String
  automationAgent   AutomationAgent @relation(fields: [automationAgentId], references: [id], onDelete: Cascade)

  name    String
  email   String
  message String @db.Text

  status         String   @default("PENDING") // PENDING | QUALIFIED | NOT_QUALIFIED | FAILED
  score          Float?
  aiReasoning    String?  @db.Text
  followUpSent   Boolean  @default(false)
  followUpBody   String?  @db.Text
  errorMessage   String?

  createdAt DateTime @default(now())

  @@index([automationAgentId, createdAt])
}

// ============================================================================
// FEATURE: Tool Agent conversation history — tracks multi-turn sessions so
// the LLM can maintain context across user messages within a session.
// Mirrors Chatbot Conversation/Message pattern but scoped to ToolAgent.
// ============================================================================

model AgentConversation {
  id          String        @id @default(cuid())
  toolAgentId String
  toolAgent   ToolAgent     @relation(fields: [toolAgentId], references: [id], onDelete: Cascade)

  sessionId      String
  memorySummary  String?   @db.Text  // rolling compressed summary of older turns
  summarizedUpTo DateTime?           // timestamp of last message included in memorySummary

  createdAt DateTime @default(now())

  messages AgentMessage[]

  @@index([toolAgentId, sessionId])
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String  // "user" | "assistant" | "tool"
  content String  @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}